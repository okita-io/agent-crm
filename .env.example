# Agent CRM configuration.
# Copy to .env and adjust. All values have sane local defaults.

# ---- Database ----
# SQLite (default, zero dependencies):
CRM_DATABASE_URL=sqlite:///./data/agent_crm.db
#
# Postgres (matches the eventual Synology NAS target; used by docker-compose):
# CRM_DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/agent_crm

# ---- API service ----
CRM_API_HOST=0.0.0.0
CRM_API_PORT=8000

# ---- Dashboard ----
CRM_DASHBOARD_PORT=8501
# API base URL for the live agent observer panel.
CRM_API_BASE_URL=http://api:8000
# Auto-refresh interval (seconds) for the observer tab.
CRM_OBSERVER_REFRESH_SECONDS=3

# ---- LLM (Spark queue proxy) ----
# CRM agents must use the queue service, NOT Spark SGLang directly.
# Hermes and other ranch agents already hit Spark at 10.0.1.9:8888; the queue
# observes Spark's global occupancy and admits CRM work only when a session
# slot is free. Cap is 4 concurrent Spark sessions (not 6) to leave GPU
# headroom for ComfyUI on the same Spark host (~250k context model).
#
# Docker compose: spark-queue service + CRM_LLM_BASE_URL below.
# Local dev without compose: run spark-queue and point here.
CRM_LLM_BASE_URL=http://spark-queue:8088/v1

# ---- Local search + scrape (ranch host services) ----
# SearXNG JSON search. From CRM containers use host.docker.internal.
CRM_SEARXNG_URL=http://host.docker.internal:8080
# Self-hosted Firecrawl API (not hosted firecrawl.dev). Unauthenticated locally.
CRM_FIRECRAWL_URL=http://host.docker.internal:3002
# Outbound Hunter caps per run (pages scraped, search results considered).
CRM_HUNTER_MAX_PAGES_PER_RUN=8
CRM_HUNTER_SEARCH_RESULT_LIMIT=15
# Hunt loop defaults (bounded branching resource collection).
CRM_HUNTER_MAX_QUERIES_DEFAULT=20
CRM_HUNTER_MAX_MINUTES_DEFAULT=25
CRM_HUNTER_MAX_BRANCH_TERMS=5

# ---- Spark queue service (spark-queue container) ----
# Upstream Spark SGLang OpenAI-compatible API. Do NOT default to 10.0.1.8:1234.
SPARK_LLM_BASE_URL=http://spark:8888/v1
SPARK_LLM_MODEL=qwen3.8-27b-sglang
# Global Spark session cap shared with Hermes (4, not 6 — ComfyUI headroom).
SPARK_LLM_MAX_CONCURRENCY=4
SPARK_LLM_QUEUE_TIMEOUT=600
SPARK_LLM_OCCUPANCY_POLL_INTERVAL=0.25
SPARK_LLM_HOST=0.0.0.0
SPARK_LLM_PORT=8088

# ---- Behavior ----
# A lead scoring at or above this priority score is flagged "hot".
CRM_HOT_LEAD_THRESHOLD=80

# Echo SQL statements to logs (debugging).
CRM_SQL_ECHO=false
